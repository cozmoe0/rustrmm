# ---------------------------------------------------------------------------
# RustRMM docker compose settings — copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# URL people use to open the web console (host name or IP of this machine).
RUSTRMM_CONSOLE_URL=https://rmm.example.internal

# URL agents use to reach the gateway. For remote workers, point a public DNS name at your
# firewall and forward its TCP 443 to this host's agent port (8444 below).
RUSTRMM_AGENT_URL=https://rmm.example.internal:8444

# Host ports (container listens on 8443 for the console and 8444 for agents).
RUSTRMM_CONSOLE_PORT=443
RUSTRMM_AGENT_PORT=8444

# TLS mode:
#   internal — built-in certificate authority (default; agents pin it automatically)
#   custom   — your own certificate, e.g. from Active Directory Certificate Services
#              (mount files and set RUSTRMM_TLS_CERT / RUSTRMM_TLS_KEY)
#   proxy    — plain HTTP behind a TLS-terminating reverse proxy you trust
RUSTRMM_TLS_MODE=internal

# Noise IK end-to-end channel for agents: auto | required. Defaults to `required` in proxy mode
# (the proxy terminates TLS; Noise keeps agent traffic private from it) and `auto` otherwise.
# RUSTRMM_AGENT_NOISE=

# Extra host names or IPs to include in the internal certificate (comma separated).
RUSTRMM_EXTRA_SANS=

# Reverse proxies allowed to set X-Forwarded-For (CIDRs, comma separated; proxy mode only).
RUSTRMM_TRUSTED_PROXIES=

# Console session lifetime.
RUSTRMM_SESSION_IDLE_MINUTES=30
RUSTRMM_SESSION_MAX_HOURS=12

# Time zone used for backup schedules.
TZ=UTC

# Image to run (leave the default to build locally from this repository).
# RUSTRMM_IMAGE=ghcr.io/<owner>/rustrmm-server:latest
